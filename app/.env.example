# Copy to .env.local for local dev (all optional locally; required in production).

# The passcode you type on the login page. Dev default: "dev".
APP_PASSWORD=

# Long random string used to sign the session cookie: `openssl rand -base64 32`
SESSION_SECRET=

# Postgres connection string (Supabase/Neon). Leave empty locally to use embedded PGlite in app/.data/.
# For Supabase use the pooled (transaction mode, port 6543) URL.
DATABASE_URL=
